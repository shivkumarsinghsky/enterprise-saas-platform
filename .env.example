# Copy to .env for local development (`cp .env.example .env`). Never commit .env.
# These are local development values matching docker-compose.yml, not real secrets.

# --- Migrations (schema owner) ------------------------------------------------------------------------
MIGRATION_DATABASE_URL=postgres://saas_owner:owner-local-dev@localhost:5432/saas
# Password assigned to the RLS-restricted application role created by the migration
APP_DB_PASSWORD=app-local-dev
# Optional: dedicated clusters to migrate, JSON {"placement": "owner url"}
MIGRATION_DEDICATED_DATABASES={}

# --- Application (connects as saas_app, which is subject to row-level security) ------------------------
DATABASE_URL=postgres://saas_app:app-local-dev@localhost:5432/saas
# Optional dedicated clusters for tenants with placement != pooled, JSON {"placement": "app url"}
DEDICATED_DATABASES={}
REDIS_URL=redis://localhost:6379

# Platform operator credential for /platform/* — generate with: openssl rand -hex 32
PLATFORM_API_KEY=local-dev-platform-key-change-me-0000

# RS256 signing key (PKCS#8 PEM). Leave empty in development to use an ephemeral key.
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
JWT_PRIVATE_KEY=
JWT_ISSUER=https://saas.local/
JWT_AUDIENCE=saas-api
ACCESS_TOKEN_TTL_SECONDS=900

ROLES=api,worker
HTTP_PORT=3000
LOG_LEVEL=info
OUTBOX_POLL_INTERVAL_MS=1000
