{
  "name": "enterprise-saas-plateform",
  "version": "1.0.0",
  "description": "Multi-tenant enterprise SaaS reference architecture: tenant isolation with PostgreSQL RLS, tenant-aware auth, RBAC, entitlements, audit logging, rate limiting",
  "author": "Shiv Kumar (https://github.com/shivkumarsinghsky)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsx --env-file=.env src/main.ts",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "check:docs": "python3 scripts/check_links.py ."
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
